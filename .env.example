# Buzz Solo — environment template. Copy to .env and adjust.
# The sovereign node itself is profile-driven (~/.config/buzz/profiles/) —
# these vars serve development runs of the local relay and CLI.

# Durable local relay
BUZZ_BIND_ADDR=127.0.0.1:3000
RELAY_URL=ws://127.0.0.1:3000

# CLI development identity (never commit a real key)
# BUZZ_PRIVATE_KEY=
# BUZZ_RELAY_URL=ws://127.0.0.1:3000

RUST_LOG=buzz_local_relay=debug,buzz_cli=debug
