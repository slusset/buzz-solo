# Buzz Solo — development environment template. Copy to .env and adjust.
# The live sovereign node remains profile-driven (~/.config/buzz/profiles/).

# Project-local CLI commands select the isolated development profile.
BUZZ_PROFILE=dev

# Development relay. The data root is XDG_DATA_HOME/buzz-local-relay/dev.
BUZZ_DEV_BIND_ADDR=127.0.0.1:3100
# BUZZ_DEV_DATA_ROOT=

# Development identity; keep this separate from the live node credentials.
# BUZZ_DEV_PRIVATE_KEY=

# Legacy agent-harness variables, when a development agent is explicitly used.
# BUZZ_PRIVATE_KEY=$BUZZ_DEV_PRIVATE_KEY
# BUZZ_RELAY_URL=ws://127.0.0.1:3100

RUST_LOG=buzz_local_relay=debug,buzz_cli=debug
